# Netlify serves wallet.html at /wallet too (pretty URLs rewrite the homepage
# links to /wallet), so the wallet's strict policy must name every path it is
# served at. Each path gets exactly one CSP: a second, broader rule would be
# enforced as well and could block the wallet's XRPL connections.
/wallet
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss://xrplcluster.com wss://s.altnet.rippletest.net:51233 https://faucet.altnet.rippletest.net; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

/wallet/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss://xrplcluster.com wss://s.altnet.rippletest.net:51233 https://faucet.altnet.rippletest.net; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

/wallet.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' wss://xrplcluster.com wss://s.altnet.rippletest.net:51233 https://faucet.altnet.rippletest.net; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
